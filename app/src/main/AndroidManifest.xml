<?xml version="1.0" encoding="utf-8"?>
<!-- REQUIRES_REVIEW: permissions de l'app (SPEC §8, ARCHITECTURE §6). CAMERA est la seule permission autorisée. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Ajoutée par androidx.core pour enregistrer des récepteurs sous l'API 33.
         Inutile avec minSdk 33, et NF6 n'autorise que CAMERA. -->
    <!-- Ajoutée par androidx.media3-common, tiré par CameraX. L'app ne lit jamais l'état du réseau
         et NF6 n'autorise que CAMERA. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- REQUIRES_REVIEW: s'affiche par-dessus l'écran verrouillé (SPEC F28). L'app n'affiche aucune
             donnée personnelle et n'enregistre rien; les paramètres Android restent derrière le déverrouillage. -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:showWhenLocked="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tuile de réglages rapides (SPEC F27). Seul le système peut s'y lier. -->
        <service
            android:name=".app.GoosescopeTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
